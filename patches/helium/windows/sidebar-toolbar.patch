+                                   id == VIEW_ID_FORWARD_BUTTON ||
+                                   id == VIEW_ID_RELOAD_BUTTON ||
+                                   id == VIEW_ID_HOME_BUTTON;
+        if (is_navigation != navigation) {
+          continue;
+        }
+        const gfx::Size preferred = child->GetPreferredSize();
+        const int child_width = std::min(preferred.width(), inner_width);
+        if (child_width <= 0 || preferred.height() <= 0) {
+          continue;
+        }
+        if (x + child_width > width - kPadding) {
+          finish_row();
+        }
+        layout.child_layouts.push_back(
+            {child, true, gfx::Rect(x, y, child_width, preferred.height()),
+             views::SizeBounds(child_width, preferred.height())});
+        x += child_width + kGap;
+        row_height = std::max(row_height, preferred.height());
+      }
+      finish_row();
+    }
+
+    if (location_bar_ && IsChildIncludedInLayout(location_bar_)) {
+      const int height = location_bar_->GetPreferredSize().height();
+      layout.child_layouts.push_back(
+          {location_bar_.get(), true, gfx::Rect(kPadding, y, inner_width, height),
+           views::SizeBounds(inner_width, height)});
+      y += height + kPadding;
+    }
