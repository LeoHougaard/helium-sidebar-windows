+views::View::Views BrowserView::GetChildrenInZOrder() {
+  auto children = views::ClientView::GetChildrenInZOrder();
+  if (!zen_top_chrome_layer_enabled_) {
+    return children;
+  }
+
+  // Keep the toolbar above the page and side panel for painting and hit
+  // testing. The tab strip and window scrims retain their higher z-order.
+  const auto toolbar = std::find(children.begin(), children.end(),
+                                 static_cast<View*>(top_container_.get()));
+  const auto tabs = std::find(
+      children.begin(), children.end(),
+      static_cast<View*>(horizontal_tab_strip_region_view_.get()));
+  if (toolbar < tabs && tabs != children.end()) {
+    std::rotate(toolbar, toolbar + 1, tabs);
+  }
+  return children;
+}
