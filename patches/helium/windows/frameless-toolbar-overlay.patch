+void BrowserView::UpdateZenModeTopChromeLayer() {
+  const bool floating =
+      top_container_ && top_container_->parent() == this &&
+      HasFloatingZenModeTopChrome();
+  if (floating == zen_top_chrome_layer_enabled_) {
+    return;
+  }
+
+  zen_top_chrome_layer_enabled_ = floating;
+  if (floating) {
+    top_container_->SetPaintToLayer();
+    top_container_->layer()->SetFillsBoundsOpaquely(false);
+    top_container_->layer()->SetMasksToBounds(true);
+  } else if (top_container_ && top_container_->parent() == this) {
+    top_container_->DestroyLayer();
+  }
+  ReorderLayers();
+}
